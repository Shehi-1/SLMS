<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Change Password</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <main class="auth-page login-page">
    <section class="brand-panel compact-brand">
      <a class="back-link" href="/<%= area %>/login">Sign out</a>
      <div class="brand-mark">SL</div>
      <p class="eyebrow">ACCOUNT SECURITY</p>
      <h1>One quick update.</h1>
      <p class="brand-copy">Choose a new password before entering your workspace.</p>
    </section>
    <section class="access-panel">
      <div class="access-content login-content">
        <p class="eyebrow">PASSWORD REQUIRED</p>
        <h2>Set a new password</h2>
        <p class="muted">Use at least 8 characters and keep it private.</p>
        <% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %>
        <form class="login-form" action="/change-password" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="password">New password</label>
          <div class="input-wrap"><span class="input-icon">*</span><input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required></div>
          <label for="confirmPassword">Confirm new password</label>
          <div class="input-wrap"><span class="input-icon">*</span><input id="confirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required></div>
          <button class="submit-button" type="submit">Save password <span>→</span></button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>
