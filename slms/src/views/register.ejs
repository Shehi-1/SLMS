<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create <%= area === 'admin' ? 'Administrator' : 'Student' %> Account</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <main class="auth-page login-page register-page">
    <section class="brand-panel compact-brand">
      <a class="back-link" href="<%= area === 'admin' ? '/administrator-login' : '/student-login' %>">← Back to sign in</a>
      <div class="brand-mark">SL</div>
      <p class="eyebrow">STUDENT LOGBOOK</p>
      <h1>Start with a clear record.</h1>
      <p class="brand-copy">Create your <%= area === 'admin' ? 'administrator' : 'student' %> account and keep your placement information organized from day one.</p>
      <div class="login-role-tag <%= area %>"><span></span><%= area === 'admin' ? 'Administrator registration' : 'Student registration' %></div>
    </section>
    <section class="access-panel">
      <div class="access-content login-content">
        <p class="eyebrow"><%= area === 'admin' ? 'ADMINISTRATOR PORTAL' : 'STUDENT PORTAL' %></p>
        <h2>Create your account</h2>
        <p class="muted">Use an email you can access to keep your account recoverable.</p>
        <% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %>
        <% if (created) { %><div class="form-success" role="status">Account created. You can now sign in.</div><% } %>
        <form class="login-form register-form" action="/<%= area %>/register" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="fullname">Full name</label>
          <div class="input-wrap"><span class="input-icon">✦</span><input id="fullname" name="fullname" value="<%= values.fullname || '' %>" autocomplete="name" placeholder="Your full name" required></div>
          <label for="username">Username</label>
          <div class="input-wrap"><span class="input-icon">@</span><input id="username" name="username" value="<%= values.username || '' %>" autocomplete="username" placeholder="Choose a username" required></div>
          <label for="email">Email address</label>
          <div class="input-wrap"><span class="input-icon">✉</span><input id="email" name="email" type="email" value="<%= values.email || '' %>" autocomplete="email" placeholder="you@example.com" required></div>
          <% if (area === 'student') { %>
            <label for="regNo">Registration number</label>
            <div class="input-wrap"><span class="input-icon">#</span><input id="regNo" name="regNo" value="<%= values.regNo || '' %>" autocomplete="off" placeholder="e.g. SIWES/2026/001" required></div>
            <label for="level">Level</label>
            <div class="input-wrap"><span class="input-icon">L</span><select id="level" name="level" required><option value="">Select your level</option><% ['100 Level', '200 Level', '300 Level', '400 Level', '500 Level'].forEach(level => { %><option value="<%= level %>" <%= values.level === level ? 'selected' : '' %>><%= level %></option><% }) %></select></div>
          <% } %>
          <% if (area === 'admin') { %>
            <label for="staffNo">Staff number</label>
            <div class="input-wrap"><span class="input-icon">#</span><input id="staffNo" name="staffNo" value="<%= values.staffNo || '' %>" autocomplete="off" placeholder="e.g. STAFF/001" required></div>
          <% } %>
          <% if (area === 'admin' && process.env.ADMIN_REGISTRATION_KEY) { %>
            <label for="registrationKey">Administrator setup key</label>
            <div class="input-wrap"><span class="input-icon">#</span><input id="registrationKey" name="registrationKey" type="password" autocomplete="off" placeholder="Enter setup key" required></div>
          <% } %>
          <label for="password">Password</label>
          <div class="input-wrap"><span class="input-icon">*</span><input id="password" name="password" type="password" minlength="8" autocomplete="new-password" placeholder="At least 8 characters" required></div>
          <button class="submit-button" type="submit">Create account <span>→</span></button>
        </form>
        <p class="access-footer">Already registered? <a class="text-link" href="<%= area === 'admin' ? '/administrator-login' : '/student-login' %>">Sign in here</a></p>
      </div>
    </section>
  </main>
</body>
</html>
