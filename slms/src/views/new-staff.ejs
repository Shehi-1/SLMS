<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create Staff Account</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <main class="auth-page login-page register-page">
    <section class="brand-panel compact-brand">
      <a class="back-link" href="/admin/dashboard">← Back to dashboard</a>
      <div class="brand-mark">SL</div>
      <p class="eyebrow">ADMINISTRATOR CONSOLE</p>
      <h1>Build a trusted team.</h1>
      <p class="brand-copy">Create a staff account for a team member who needs administrator access to the logbook workspace.</p>
      <div class="login-role-tag admin"><span></span>Staff account creation</div>
    </section>
    <section class="access-panel">
      <div class="access-content login-content">
        <p class="eyebrow">STAFF MANAGEMENT</p>
        <h2>Create staff account</h2>
        <p class="muted">Staff members can sign in to the administrator workspace.</p>
        <% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %>
        <% if (request.query.created) { %><div class="form-success" role="status">Staff account created successfully.</div><% } %>
        <form class="login-form register-form" action="/admin/staff/new" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="fullname">Full name</label>
          <div class="input-wrap"><span class="input-icon">✦</span><input id="fullname" name="fullname" value="<%= values.fullname || '' %>" autocomplete="name" placeholder="Staff member's full name" required></div>
          <label for="username">Username</label>
          <div class="input-wrap"><span class="input-icon">@</span><input id="username" name="username" value="<%= values.username || '' %>" autocomplete="username" placeholder="Choose a username" required></div>
          <label for="email">Email address</label>
          <div class="input-wrap"><span class="input-icon">✉</span><input id="email" name="email" type="email" value="<%= values.email || '' %>" autocomplete="email" placeholder="staff@example.com" required></div>
          <label for="staffNo">Staff number</label>
          <div class="input-wrap"><span class="input-icon">#</span><input id="staffNo" name="staffNo" value="<%= values.staffNo || '' %>" autocomplete="off" placeholder="e.g. STAFF/001" required></div>
          <label for="password">Initial password</label>
          <div class="input-wrap"><span class="input-icon">*</span><input id="password" name="password" type="password" minlength="8" autocomplete="new-password" placeholder="At least 8 characters" required></div>
          <button class="submit-button" type="submit">Create staff account <span>→</span></button>
        </form>
        <p class="access-footer"><a class="text-link" href="/admin/dashboard">Return to dashboard</a></p>
      </div>
    </section>
  </main>
</body>
</html>
