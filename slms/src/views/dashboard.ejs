<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= area === 'admin' ? 'Administrator Dashboard' : 'Student Dashboard' %></title>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
    <div class="dashboard-shell">
      <aside class="sidebar">
        <a class="brand" href="/<%= area %>/dashboard"><span class="brand-mark">SL</span><span>Student Logbook</span></a>
        <div class="workspace-label"><%= area === 'admin' ? 'ADMINISTRATOR' : 'STUDENT WORKSPACE' %></div>
        
        <!-- User Account Card - Only for Students -->
        <% if (area === 'student') { %>
        <div class="sidebar-user-card">
          <div class="user-avatar"><%= user.fullname.charAt(0).toUpperCase() %></div>
          <div class="user-info">
            <div class="user-name"><%= user.fullname %></div>
            <div class="user-role">📚 Student</div>
            <div class="user-email"><%= user.email %></div>
          </div>
        </div>
        <% } %>
        
        <nav class="nav-list" aria-label="Main navigation">
          <a class="nav-link <%= view === 'overview' ? 'active' : '' %>" href="/<%= area %>/dashboard"><span class="nav-icon">⌂</span>Overview</a>
          <% if (area === 'student') { %>
          <a class="nav-link <%= view === 'timeline' ? 'active' : '' %>" href="/<%= area %>/dashboard?view=timeline"><span class="nav-icon">◷</span>Placement timeline</a>
          <a class="nav-link <%= view === 'details' ? 'active' : '' %>" href="/<%= area %>/dashboard?view=details"><span class="nav-icon">○</span>Your details</a>
            <a class="nav-link <%= view === 'attendance' ? 'active' : '' %>" href="/student/dashboard?view=attendance"><span class="nav-icon">◷</span>Attendance</a>
            <a class="nav-link <%= view === 'reports' ? 'active' : '' %>" href="/student/dashboard?view=reports"><span class="nav-icon">▤</span>Weekly reports</a>
          <% } else { %>
          <a class="nav-link" href="/admin/users"><span class="nav-icon">○</span>Student accounts</a>
          <a class="nav-link" href="/admin/attendance"><span class="nav-icon">◷</span>Attendance</a>
          <a class="nav-link" href="/admin/reports"><span class="nav-icon">▤</span>Weekly reports</a>
            <a class="nav-link <%= view === 'details' ? 'active' : '' %>" href="/admin/dashboard?view=details"><span class="nav-icon">○</span>Your details</a>
          <% } %>
        </nav>
        <div class="sidebar-footer"><div class="secure-note"><span class="status-dot"></span><span><strong>Workspace secure</strong><small>Session protected</small></span></div><form action="/<%= area %>/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout-button" type="submit">Sign out <span>↗</span></button></form></div>
      </aside>
      <main class="dashboard-main">
        <header class="topbar"><div><p class="eyebrow">OVERVIEW</p><h1><%= area === 'admin' ? 'Good to see you, ' + user.fullname.split(' ')[0] + '.' : 'Your placement, in view.' %></h1></div><div class="date-stamp"><span class="pulse"></span>Live workspace</div></header>
        <% if (area === 'student') { %>
          <% if (view === 'overview') { %><section class="welcome-banner"><div><p class="eyebrow">STUDENT LOGBOOK</p><h2>Welcome, <%= user.fullname %>.</h2><p>Your account is ready. Start recording your placement activity to build a clear weekly history.</p></div><div class="banner-mark">S</div></section><section class="stat-grid"><article class="stat-card"><span class="stat-label">LOGBOOK ENTRIES</span><strong><%= stats.reportCount %></strong><small><%= stats.reportCount ? 'Reports submitted' : 'Ready for your first report' %></small></article><article class="stat-card accent"><span class="stat-label">ATTENDANCE RECORDS</span><strong><%= stats.attendanceCount %></strong><small><%= stats.attendanceCount ? 'Placement days recorded' : 'No attendance recorded yet' %></small></article><article class="stat-card"><span class="stat-label">PROFILE STATUS</span><strong>Ready</strong><small>Your account is active</small></article></section><div class="overview-links"><a href="/student/attendance">Mark attendance <span>→</span></a><a href="/student/reports">Upload weekly report <span>→</span></a></div><% } %>
        <% if (view === 'attendance') { %><% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %><section class="panel attendance-action-panel"><div><p class="eyebrow">TODAY</p><h2>Mark your attendance</h2><p>Clock in when you begin your placement day and clock out when you finish.</p></div><% const openEntry = attendance.find(entry => !entry.clockOut); %><% if (openEntry) { %><form action="/student/attendance/clock-out/<%= openEntry._id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-button clock-out-button" type="submit">Clock out <span>→</span></button></form><% } else { %><form action="/student/attendance/clock-in" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-button" type="submit">Clock in <span>→</span></button></form><% } %></section><section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">HISTORY</p><h2>Attendance history</h2></div><span class="panel-badge"><%= attendance.length %> records</span></div><div class="record-list"><% if (!attendance.length) { %><div class="empty-state"><div class="empty-icon">◷</div><h3>No attendance yet</h3><p>Your clock-in and clock-out records will appear here.</p></div><% } else { %><% attendance.forEach(entry => { %><div class="record-row"><div><strong><%= new Date(entry.clockIn).toLocaleDateString() %></strong><small><%= new Date(entry.clockIn).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %> to <%= entry.clockOut ? new Date(entry.clockOut).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'In progress' %></small></div><span class="record-status <%= entry.clockOut ? 'complete' : 'open' %>"><%= entry.clockOut ? `${entry.durationMinutes || 0} min` : 'Active' %></span></div><% }) %><% } %></div></section><% } %>
        <% if (view === 'reports') { %><% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %><div class="report-layout"><section class="panel report-form-panel"><div class="panel-heading"><div><p class="eyebrow">NEW OR UPDATE</p><h2>Weekly report</h2></div><span class="panel-badge">One report per week</span></div><form class="report-form" action="/student/reports" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="weekStarting">Week starting</label><input id="weekStarting" name="weekStarting" type="date" value="<%= values.weekStarting || '' %>" required><label for="title">Report title</label><input id="title" name="title" maxlength="120" value="<%= values.title || '' %>" placeholder="e.g. Frontend orientation" required><label for="summary">What did you work on?</label><textarea id="summary" name="summary" maxlength="5000" rows="7" placeholder="Describe your tasks, learning, and progress this week." required><%= values.summary || '' %></textarea><label for="attachment">Supporting document <span class="field-note">optional, max 5 MB</span></label><input id="attachment" name="attachment" type="file" accept=".pdf,.doc,.docx,.txt"><button class="primary-button" type="submit">Submit weekly report <span>→</span></button></form></section><section class="panel submitted-panel"><div class="panel-heading"><div><p class="eyebrow">SUBMITTED</p><h2>Your reports</h2></div><span class="panel-badge"><%= reports.length %> total</span></div><div class="record-list"><% if (!reports.length) { %><div class="empty-state"><div class="empty-icon">▤</div><h3>No reports submitted</h3><p>Your weekly logbook history will appear here.</p></div><% } else { %><% reports.forEach(report => { %><article class="report-item"><div class="report-item-top"><strong><%= report.title %></strong><span class="record-status complete"><%= report.status %></span></div><small>Week of <%= new Date(report.weekStarting).toLocaleDateString() %></small><p><%= report.summary %></p><% if (report.attachment) { %><span class="attachment-name"><%= report.attachment.originalName %></span><% } %></article><% }) %><% } %></div></section></div><% } %>
        <% if (view === 'timeline') { %><section class="panel activity-panel standalone-panel"><div class="panel-heading"><div><p class="eyebrow">ACTIVITY</p><h2>Placement timeline</h2></div><span class="panel-badge"><%= timeline.length %> entries</span></div><% if (!timeline.length) { %><div class="empty-state"><div class="empty-icon">+</div><h3>Your timeline starts here</h3><p>Logbook reports and attendance will appear here as you record your placement.</p><div class="timeline-actions"><a class="primary-button" href="/student/dashboard?view=attendance">Mark attendance <span>→</span></a><a class="secondary-link" href="/student/dashboard?view=reports">Write weekly report <span>→</span></a></div></div><% } else { %><div class="timeline-list"><% timeline.forEach(item => { %><a class="timeline-item" href="<%= item.href %>"><span class="timeline-marker <%= item.type %>"><%= item.type === 'report' ? '▤' : '◷' %></span><span class="timeline-copy"><strong><%= item.title %></strong><small><%= new Date(item.date).toLocaleDateString() %> · <%= item.detail %></small></span><span class="timeline-arrow">→</span></a><% }) %></div><% } %></section><% } %>
        <% if (view === 'details') { %><section class="panel profile-panel standalone-panel"><div class="panel-heading"><div><p class="eyebrow">ACCOUNT</p><h2>Your details</h2></div><span class="avatar"><%= user.fullname.charAt(0).toUpperCase() %></span></div><dl class="profile-list"><div><dt>Full name</dt><dd><%= user.fullname %></dd></div><div><dt>Username</dt><dd>@<%= user.username %></dd></div><div><dt>Registration no.</dt><dd><%= user.regNo || 'Not provided' %></dd></div><div><dt>Level</dt><dd><%= user.level || 'Not provided' %></dd></div><div><dt>Email</dt><dd><%= user.email || 'Not provided' %></dd></div></dl><a class="secondary-link" href="/change-password">Manage password <span>→</span></a></section><% } %>
        <% } else if (view === 'users') { %><header class="topbar"><div><p class="eyebrow">STUDENT MANAGEMENT</p><h1>Student accounts</h1></div><a class="primary-button" href="/admin/users/new">Create student <span>→</span></a></header><section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">REGISTERED STUDENTS</p><h2>Placement workspaces</h2></div><span class="panel-badge"><%= students.length %> accounts</span></div><div class="record-list"><% if (!students.length) { %><div class="empty-state"><div class="empty-icon">+</div><h3>No student accounts yet</h3><p>Create the first student workspace to begin recording placement activity.</p><div class="timeline-actions"><a class="primary-button" href="/admin/users/new">Create student <span>→</span></a></div></div><% } else { %><% students.forEach(student => { %><article class="admin-record"><div class="record-row"><div><strong><%= student.fullname %></strong><small>@<%= student.username %> · <%= student.regNo %></small></div><span class="record-status complete"><%= student.level || 'Level not set' %></span></div><p class="record-meta"><%= student.email %></p></article><% }) %><% } %></div></section>
        <% } else if (view === 'admin-attendance' || view === 'admin-reports') { %><header class="topbar"><div><p class="eyebrow">ADMIN REVIEW</p><h1><%= view === 'admin-attendance' ? 'Attendance' : 'Weekly reports' %></h1></div><div class="date-stamp"><span class="pulse"></span>Live workspace</div></header><section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow"><%= view === 'admin-attendance' ? 'PLACEMENT DAYS' : 'LOGBOOK SUBMISSIONS' %></p><h2><%= view === 'admin-attendance' ? 'Student attendance records' : 'Student weekly reports' %></h2></div><span class="panel-badge"><%= adminRecords.length %> records</span></div><div class="record-list"><% if (!adminRecords.length) { %><div class="empty-state"><div class="empty-icon"><%= view === 'admin-attendance' ? '◷' : '▤' %></div><h3>No records yet</h3><p>Student activity will appear here when it is submitted.</p></div><% } else { %><% adminRecords.forEach(record => { %><% if (view === 'admin-reports') { %><a class="report-list-row" href="/admin/reports/<%= record._id %>"><span class="report-list-main"><strong><%= record.title %></strong><small><%= record.student ? record.student.fullname : 'Unknown student' %> · Week of <%= new Date(record.weekStarting).toLocaleDateString() %></small></span><span class="report-list-arrow"><span class="record-status <%= record.status === 'reviewed' ? 'complete' : 'open' %>"><%= record.status %></span><b>→</b></span></a><% } else { %><article class="admin-record"><div class="record-row"><div><strong><%= record.student ? record.student.fullname : 'Unknown student' %></strong><small><%= new Date(record.clockIn).toLocaleDateString() %></small></div><span class="record-status <%= record.clockOut ? 'complete' : 'open' %>"><%= record.clockOut ? `${record.durationMinutes || 0} min` : 'Active' %></span></div><p class="record-meta">Clock in: <%= new Date(record.clockIn).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %> · Clock out: <%= record.clockOut ? new Date(record.clockOut).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Not yet' %></p></article><% } %><% }) %><% } %></div></section>
        <% } else if (view === 'report-detail') { %><% if (!adminReport) { %><section class="panel"><div class="empty-state"><h2>Weekly report not found</h2><a class="secondary-link" href="/admin/dashboard?view=admin-reports">Back to reports <span>→</span></a></div></section><% } else { %><header class="topbar"><div><p class="eyebrow">REPORT REVIEW</p><h1>Weekly report</h1></div><a class="secondary-link detail-back" href="/admin/dashboard?view=admin-reports">← Back to reports</a></header><article class="panel report-detail-panel"><div class="report-detail-heading"><div><p class="eyebrow">WEEK OF <%= new Date(adminReport.weekStarting).toLocaleDateString() %></p><h2><%= adminReport.title %></h2><p class="detail-student"><%= adminReport.student ? adminReport.student.fullname : 'Unknown student' %><% if (adminReport.student && adminReport.student.regNo) { %> · <%= adminReport.student.regNo %><% } %></p></div><span class="record-status <%= adminReport.status === 'reviewed' ? 'complete' : 'open' %>"><%= adminReport.status %></span></div><div class="report-detail-body"><h3>Weekly summary</h3><p><%= adminReport.summary %></p></div><% if (adminReport.attachment) { %><div class="attachment-box"><span>Attached document</span><strong><%= adminReport.attachment.originalName %></strong></div><% } %><% if (adminReport.status !== 'reviewed') { %><form class="review-form" action="/admin/reports/<%= adminReport._id %>/review" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-button" type="submit">Mark as reviewed <span>✓</span></button></form><% } %></article><% } %>
        <% } else { %>
          <% if (view === 'details') { %><section class="panel profile-panel standalone-panel"><div class="panel-heading"><div><p class="eyebrow">ACCOUNT</p><h2>Your details</h2></div><span class="avatar"><%= user.fullname.charAt(0).toUpperCase() %></span></div><dl class="profile-list"><div><dt>Full name</dt><dd><%= user.fullname %></dd></div><div><dt>Username</dt><dd>@<%= user.username %></dd></div><div><dt>Staff no.</dt><dd><%= user.staffNo || 'Not provided' %></dd></div><div><dt>Email</dt><dd><%= user.email || 'Not provided' %></dd></div></dl><a class="secondary-link" href="/change-password">Manage password <span>→</span></a></section><% } else { %><section class="welcome-banner admin-banner"><div><p class="eyebrow">ADMINISTRATOR CONSOLE</p><h2>Keep student progress moving.</h2><p>Manage student accounts and prepare the workspace for placement records.</p></div><div class="banner-mark">A</div></section>
          <section class="stat-grid"><a class="stat-card stat-card-link" href="/admin/users"><span class="stat-label">STUDENT ACCOUNTS</span><strong><%= stats.studentCount %></strong><small>View registered students</small></a><a class="stat-card accent stat-card-link" href="/admin/reports"><span class="stat-label">REPORTS</span><strong><%= stats.reportCount %></strong><small>Review submitted reports</small></a><article class="stat-card"><span class="stat-label">SYSTEM STATUS</span><strong>Ready</strong><small>Authentication services online</small></article></section>
          <section class="panel admin-action-panel"><div><p class="eyebrow">NEXT ACTION</p><h2>Manage your team workspace</h2><p>Create student accounts for placement records or staff accounts for trusted administrators.</p></div><div class="admin-actions"><a class="primary-button" href="/admin/users/new">Create student <span>→</span></a><a class="secondary-link" href="/admin/staff/new">Create staff <span>→</span></a></div></section>
          <% } %>
        <% } %>
        <% if (area === 'student') { %>
          <footer class="dashboard-footer student-dashboard-footer">
            <div class="footer-brand-block">
              <span class="footer-brand-mark">SL</span>
              <div>
                <strong>Student Logbook</strong>
                <span>Secure records for better placements</span>
              </div>
            </div>
            <div class="footer-support-block">
              <span class="footer-copyright">&copy; <%= new Date().getFullYear() %> Student Logbook Management System</span>
              <a href="mailto:abdurrazakmukutar12@gmail.com">Need help? Contact student support <span aria-hidden="true">&rarr;</span></a>
            </div>
          </footer>
        <% } else { %>
          <footer class="dashboard-footer">Student Logbook Management System <span>·</span> Secure records for better placements</footer>
        <% } %>
      </main>
    </div>
</body>
</html>
