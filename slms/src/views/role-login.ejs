<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Logbook Management System</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <main class="auth-page chooser-page">
    <section class="brand-panel">
      <div class="brand-mark">SL</div>
      <p class="eyebrow">SIWES / INDUSTRIAL TRAINING</p>
      <h1>Keep every week of your placement in view.</h1>
      <p class="brand-copy">A focused workspace for logbook reports, attendance records, and supervisor oversight.</p>
      <div class="brand-line"><span></span><span></span><span></span></div>
      <p class="brand-note">Secure workspace <strong>•</strong> Structured records <strong>•</strong> Clear progress</p>
    </section>
    <section class="access-panel">
      <div class="access-content">
        <p class="eyebrow">WELCOME BACK</p>
        <h2>Choose your workspace</h2>
        <p class="muted">Select the account area that matches your role.</p>
        <div class="access-options">
          <a class="access-card admin-card" href="/administrator-login"><span class="option-icon">A</span><span><strong>Administrator</strong><small>Manage students and review activity</small></span><span class="arrow">→</span></a>
          <a class="access-card student-card" href="/student-login"><span class="option-icon">S</span><span><strong>Student</strong><small>Update your logbook and attendance</small></span><span class="arrow">→</span></a>
        </div>
        <p class="access-footer">Your access is protected by role-based sign-in.</p>
      </div>
    </section>
  </main>
</body>
</html>
